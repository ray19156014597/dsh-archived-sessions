{
  "name": "dsh-archived-sessions",
  "version": "1.0.0",
  "private": true,
  "description": "Manage archived DSH sessions from Settings: restore them or delete their logs permanently.",
  "type": "module",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ray19156014597/dsh-archived-sessions.git"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check test/verify-host.mjs",
    "test": "node test/verify-host.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "license": "MIT"
}
